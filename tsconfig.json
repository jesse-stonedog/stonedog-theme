{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    // On since NEH-266, matching stonedog-style. This package parses hex
    // colours, rgb() values, font stacks and Google Fonts URLs out of arbitrary
    // remote CSS, so an index that is out of range or a capture group that did
    // not participate is reachable input, not a theoretical one — and a
    // contrast ratio computed from an undefined channel yields a plausible
    // wrong number rather than a crash. Every unguarded access is now an error;
    // handle the missing case, do not assert it away.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "paths": {
      // See jest.config.cjs — the token contract comes from the sibling
      // checkout rather than node_modules, so tsc has to agree with jest.
      "stonedog-style/contract": ["../stonedog-style/src/preset/semantic-variables.ts"]
    }
  },
  "//include": "test/ is included so @types/jest is in scope for the integration tier; excluding it runs the suite green while tsc fails on every matcher — the same trap stonedog-style documents.",
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
